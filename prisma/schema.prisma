generator client {
  provider = "prisma-client-js"
}

// Aquí le decimos que usaremos PostgreSQL (el motor de Supabase)
datasource db {
  provider = "postgresql"
}

// 1. La tabla del Negocio
model Store {
  id        String   @id @default(uuid())
  userId    String   @unique // ID del usuario dueño en Supabase Auth
  name      String // Ej: "Burgers Carlos"
  slug      String   @unique // Ej: "burgers-carlos" (Esto es para la URL única)
  whatsapp  String // El número donde llegarán los pedidos
  createdAt DateTime @default(now())

  // --- MULTIMEDIA Y BRANDING ---
  logoUrl   String?
  bannerUrl String? // NUEVO: Imagen de portada superior para darle el toque visual al inicio

  // --- MENSAJES DE WHATSAPP ---
  whatsappHeader String @default("🍔 *NUEVO PEDIDO* 🍔")
  whatsappFooter String @default("¡Hola! Quisiera realizar este pedido, quedo atento a su confirmación.")

  // --- PERSONALIZACIÓN VISUAL ---
  // Colores
  backgroundColor     String @default("#ffffff")
  themeColor          String @default("#ef4444") // Color principal (usado para botones y acentos)
  cardBackgroundColor String @default("#ffffff")
  textColor           String @default("#e5e2e1")
  subtextColor        String @default("#e4beb5")
  buttonTextColor     String @default("#ffffff") // NUEVO: Asegura que el texto dentro del botón resalte contra el themeColor

  // Tipografía
  fontHeading String @default("Epilogue")
  fontBody    String @default("Manrope")

  // Diseño del Menú
  menuLayout String @default("LIST") // NUEVO: Permite alternar entre "LINKTREE", "LIST" (clásico), y "GRID" (cuadrícula)

  // Modo de personalización (ENUM en DB, default THEME)
  customizationMode CustomizationMode @default(THEME)

  // Redes Sociales y Enlaces (NUEVO: Para colocar iconos debajo del logo como en Linktree)
  instagramUrl  String?
  tiktokUrl     String?
  googleMapsUrl String?

  // --- CONFIGURACIONES DEL NEGOCIO ---
  isActive          Boolean @default(true)
  enableDelivery    Boolean @default(true)
  enablePickup      Boolean @default(true)
  enableDineIn      Boolean @default(false)
  showProductImages Boolean @default(true)
  forceNotesModal   Boolean @default(false)
  requireCedula     Boolean @default(true)
  showBsPrice       Boolean @default(true) // Muestra el precio convertido a Bs debajo del precio en USD

  upsellCategoryId String? // Categoría estrella para el carrito

  // --- RELACIONES ---
  // Relación: Un local tiene muchas categorías
  categories    Category[]
  deliveryZones DeliveryZone[]
  customizationLayout CustomizationLayout? // 1:1 con Store
  customizationTemplates CustomizationTemplate[]
  customizationImages CustomizationImage[]
}

// 2. La tabla de Categorías (Para ordenar el menú)
model Category {
  id        String    @id @default(uuid())
  name      String
  storeId   String
  store     Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  products  Product[]
  order     Int       @default(0) // NUEVO: Para el orden visual manual de categorías
  isActive  Boolean   @default(true) // Para activar/desactivar categorías completas
  createdAt DateTime  @default(now())
}

model Product {
  id          String  @id @default(uuid())
  name        String
  description String? // Ej: "Carne 150g, queso fundido y papitas"
  price       Float
  isAvailable Boolean @default(true) // ¡La magia para apagar productos agotados!
  imageUrl    String? // URL de la imagen en Supabase Storage
  order       Int     @default(0) // NUEVO: Para el orden visual manual
  isCombo     Boolean @default(false) // Si true, se renderiza con estilo VIP en el menú
  comboBadge  String? // Etiqueta promocional. Ej: "Ahorra 15%", "Familiar", "Promo"

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  // Conversión de fotos a modelo 3D (Tripo API)
  model3dStatus   String?   // null | PROCESSING | SUCCEEDED | FAILED
  model3dTaskId   String?   // task_id en Tripo (para polling)
  model3dUrl      String?   // URL pública del .glb en el bucket models-3d
  model3dThumbUrl String?   // URL pública del preview.png
  model3dError    String?   // Mensaje de error si falló
  model3dSources  String[]  @default([]) // URLs de las fotos de origen

  // NUEVO: Relación para conectar los extras y remociones
  modifierGroups ModifierGroup[]
}

// 4. Grupos de Opciones (Ej: "Elige tus extras", "Quitar ingredientes")
model ModifierGroup {
  id         String           @id @default(cuid())
  name       String
  isRequired Boolean          @default(false) // Si es true, el cliente está obligado a elegir (Ej: Término de la carne)
  maxSelect  Int? // Límite de opciones a elegir (Ej: "Elige hasta 2 salsas")
  productId  String
  product    Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  options    ModifierOption[]
}

// Las opciones individuales (Ej: "Tocineta", "Sin cebolla")
model ModifierOption {
  id              String        @id @default(cuid())
  name            String
  price           Float         @default(0) // 0 si es "Sin cebolla", o 1.50 si es "Extra Tocineta"
  modifierGroupId String
  isAvailable     Boolean       @default(true)
  modifierGroup   ModifierGroup @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)
}

model OrderIntentLog {
  id           String   @id @default(uuid())
  storeId      String
  total        Float
  deliveryType String // Ej: "delivery", "pickup", "dinein"
  createdAt    DateTime @default(now())
}

model DeliveryZone {
  id      String @id @default(uuid())
  name    String // Ej: "Turmero", "Cagua", "Centro"
  price   Float // Ej: 2.50
  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)
}

// Configuración completa del editor avanzado (1 layout por store)
model CustomizationLayout {
  id         String   @id @default(uuid())
  storeId    String   @unique // 1 layout por store (obligatorio)
  layoutJson Json // El JSON completo del diseño avanzado
  version    Int      @default(1) // Versión para historial de cambios
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
}

// Plantillas reutilizables de diseño
model CustomizationTemplate {
  id          String        @id @default(uuid())
  name        String // Nombre de la plantilla (ej: "Moderna Oscura")
  description String? // Descripción opcional
  scope       TemplateScope // FULL_PAGE o SECTION
  sectionType String? // Si scope=SECTION: type de sección
  previewUrl  String // URL de imagen preview para el selector
  configJson  Json // Configuración a inyectar
  isPublic    Boolean       @default(true) // Si true, disponible para todos los stores
  storeId     String? // Null = plantilla global; propietario = plantilla privada
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  store Store? @relation(fields: [storeId], references: [id], onDelete: Cascade)
}

// Referencias de imágenes del bucket advanced-customization
model CustomizationImage {
  id         String   @id @default(uuid())
  storeId    String // A qué empresa pertenece (FK → Store)
  url        String // URL pública de Supabase (generada al upload)
  bucketPath String // Path interno para poder borrar después (advanced-customization/{storeId}/{filename})
  altText    String? // Texto alternativo
  sectionId  String? // Sección que la usa (opcional, para limpieza)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
}

enum CustomizationMode {
  THEME
  AVANCED
}

enum TemplateScope {
  FULL_PAGE
  SECTION
}
